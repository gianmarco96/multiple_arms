<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="turtlebot3_waffle">
    <xacro:arg name="namespace" default="robot"/>

    <!-- Base Footprint -->
    <link name="base_footprint"/>

    <!-- Base Link -->
    <link name="base_link">
        <inertial>
            <origin xyz="-0.064 0 0.048" rpy="0 0 0"/>
            <mass value="1.3729096"/>
            <inertia ixx="0.042111447" ixy="0" ixz="0" iyy="0.042111447" iyz="0" izz="0.075254874"/>
        </inertial>
        <collision name="base_collision">
            <origin xyz="-0.064 0 0.048" rpy="0 0 0"/>
            <geometry>
                <box size="0.265 0.265 0.089"/>
            </geometry>
        </collision>
        <visual name="base_visual">
            <origin xyz="-0.064 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="model://turtlebot3_common/meshes/waffle_base.dae" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
    </link>

    <!-- Other links will follow here... -->

    <!-- Joint: base_joint -->
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
    </joint>

    <!-- Plugins -->
    <gazebo>
        <plugin name="turtlebot3_diff_drive" filename="libgazebo_ros_diff_drive.so">
            <ros>
                <namespace>$(arg namespace)</namespace>
                <remapping>/tf:=tf</remapping>
            </ros>
            <update_rate>30</update_rate>
            <left_joint>wheel_left_joint</left_joint>
            <right_joint>wheel_right_joint</right_joint>
            <wheel_separation>0.287</wheel_separation>
            <wheel_diameter>0.066</wheel_diameter>
            <max_wheel_torque>20</max_wheel_torque>
            <max_wheel_acceleration>1.0</max_wheel_acceleration>
            <command_topic>cmd_vel</command_topic>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>false</publish_wheel_tf>
            <odometry_topic>odom</odometry_topic>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
        </plugin>

        <plugin name="turtlebot3_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
            <ros>
                <namespace>$(arg namespace)</namespace>
                <remapping>~/out:=joint_states</remapping>
            </ros>
            <update_rate>30</update_rate>
            <joint_name>wheel_left_joint</joint_name>
            <joint_name>wheel_right_joint</joint_name>
        </plugin>
    </gazebo>


<!-- IMU Link -->
<link name="imu_link">
    <sensor name="tb3_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <imu>
            <angular_velocity>
                <x>
                    <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>2e-4</stddev>
                    </noise>
                </x>
                <y>
                    <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>2e-4</stddev>
                    </noise>
                </y>
                <z>
                    <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>2e-4</stddev>
                    </noise>
                </z>
            </angular_velocity>
            <linear_acceleration>
                <x>
                    <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>1.7e-2</stddev>
                    </noise>
                </x>
                <y>
                    <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>1.7e-2</stddev>
                    </noise>
                </y>
                <z>
                    <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>1.7e-2</stddev>
                    </noise>
                </z>
            </linear_acceleration>
        </imu>
        <plugin name="turtlebot3_imu" filename="libgazebo_ros_imu_sensor.so">
            <ros>
                <namespace>$(arg namespace)</namespace>
                <remapping>~/out:=imu</remapping>
            </ros>
        </plugin>
    </sensor>
</link>

<!-- Base Scan -->
<link name="base_scan">
    <inertial>
        <origin xyz="-0.052 0 0.111" rpy="0 0 0"/>
        <mass value="0.114"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <collision name="lidar_sensor_collision">
        <origin xyz="-0.052 0 0.111" rpy="0 0 0"/>
        <geometry>
            <cylinder radius="0.0508" length="0.055"/>
        </geometry>
    </collision>
    <visual name="lidar_sensor_visual">
        <origin xyz="-0.064 0 0.121" rpy="0 0 0"/>
        <geometry>
            <mesh filename="model://turtlebot3_common/meshes/lds.dae" scale="0.001 0.001 0.001"/>
        </geometry>
    </visual>
    <sensor name="hls_lfcd_lds" type="ray">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <origin xyz="-0.064 0 0.121" rpy="0 0 0"/>
        <update_rate>5</update_rate>
        <ray>
            <scan>
                <horizontal>
                    <samples>360</samples>
                    <resolution>1.0</resolution>
                    <min_angle>0.0</min_angle>
                    <max_angle>6.28</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>0.12</min>
                <max>3.5</max>
                <resolution>0.015</resolution>
            </range>
            <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.01</stddev>
            </noise>
        </ray>
        <plugin name="turtlebot3_laserscan" filename="libgazebo_ros_ray_sensor.so">
            <ros>
                <namespace>$(arg namespace)</namespace>
                <remapping>~/out:=scan</remapping>
            </ros>
            <output_type>sensor_msgs/LaserScan</output_type>
            <frame_name>base_scan</frame_name>
        </plugin>
    </sensor>
</link>
<!-- Left Wheel -->
<link name="wheel_left_link">
    <inertial>
        <origin xyz="0.0 0.144 0.023" rpy="-1.57 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09" iyy="1.1192413e-05" iyz="-1.4400107e-11" izz="2.0712558e-05"/>
    </inertial>
    <collision name="wheel_left_collision">
        <origin xyz="0.0 0.144 0.023" rpy="-1.57 0 0"/>
        <geometry>
            <cylinder radius="0.033" length="0.018"/>
        </geometry>
    </collision>
    <visual name="wheel_left_visual">
        <origin xyz="0.0 0.144 0.023" rpy="0 0 0"/>
        <geometry>
            <mesh filename="model://turtlebot3_common/meshes/tire.dae" scale="0.001 0.001 0.001"/>
        </geometry>
    </visual>
</link>

<!-- Right Wheel -->
<link name="wheel_right_link">
    <inertial>
        <origin xyz="0.0 -0.144 0.023" rpy="-1.57 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09" iyy="1.1192413e-05" iyz="-1.4400107e-11" izz="2.0712558e-05"/>
    </inertial>
    <collision name="wheel_right_collision">
        <origin xyz="0.0 -0.144 0.023" rpy="-1.57 0 0"/>
        <geometry>
            <cylinder radius="0.033" length="0.018"/>
        </geometry>
    </collision>
    <visual name="wheel_right_visual">
        <origin xyz="0.0 -0.144 0.023" rpy="0 0 0"/>
        <geometry>
            <mesh filename="model://turtlebot3_common/meshes/tire.dae" scale="0.001 0.001 0.001"/>
        </geometry>
    </visual>
</link>

<!-- Caster Back Right -->
<link name="caster_back_right_link">
    <origin xyz="-0.177 -0.064 -0.004" rpy="-1.57 0 0"/>
    <inertial>
        <mass value="0.001"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <collision name="caster_right_collision">
        <geometry>
            <sphere radius="0.005"/>
        </geometry>
    </collision>
</link>

<!-- Caster Back Left -->
<link name="caster_back_left_link">
    <origin xyz="-0.177 0.064 -0.004" rpy="-1.57 0 0"/>
    <inertial>
        <mass value="0.001"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <collision name="caster_left_collision">
        <geometry>
            <sphere radius="0.005"/>
        </geometry>
    </collision>
</link>

<!-- Camera Link -->
<link name="camera_link"/>

<!-- Camera RGB Frame -->
<link name="camera_rgb_frame">
    <inertial>
        <origin xyz="0.069 -0.047 0.107" rpy="0 0 0"/>
        <mass value="0.035"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <origin xyz="0.069 -0.047 0.107" rpy="0 0 0"/>
    <sensor name="camera" type="depth">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>1</update_rate>
        <camera name="intel_realsense_r200">
            <horizontal_fov>1.02974</horizontal_fov>
            <image>
                <width>640</width>
                <height>480</height>
                <format>B8G8R8</format>
            </image>
            <clip>
                <near>0.05</near>
                <far>8.0</far>
            </clip>
            <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.007</stddev>
            </noise>
        </camera>
        <plugin name="camera_driver" filename="libgazebo_ros_camera.so">
            <ros>
                <namespace>$(arg namespace)</namespace>
            </ros>
            <frame_name>camera_rgb_frame</frame_name>
            <min_depth>0.1</min_depth>
            <max_depth>100</max_depth>
        </plugin>
    </sensor>
</link>

<!-- All remaining joints -->
<joint name="wheel_left_joint" type="revolute">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0.0 0.144 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
</joint>

<joint name="wheel_right_joint" type="revolute">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0.0 -0.144 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
</joint>

<joint name="caster_back_right_joint" type="ball">
    <parent link="base_link"/>
    <child link="caster_back_right_link"/>
</joint>

<joint name="caster_back_left_joint" type="ball">
    <parent link="base_link"/>
    <child link="caster_back_left_link"/>
</joint>

<joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.032 0 0.068" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
</joint>

<joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="-0.064 0 0.121" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
</joint>

<joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.064 -0.065 0.094" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
</joint>

<joint name="camera_rgb_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_rgb_frame"/>
    <origin xyz="0.005 0.018 0.013" rpy="1 0 0"/>
    <axis xyz="0 0 1"/>
</joint>

</robot>